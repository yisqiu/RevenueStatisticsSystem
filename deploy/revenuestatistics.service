[Unit]
Description=Shouxian Revenue Statistics System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=revenuestatistics
Group=revenuestatistics
WorkingDirectory=/data/RevenueStatisticsSystem/current
ExecStart=/data/RevenueStatisticsSystem/current/revenuestatistics
Environment=LISTEN_ADDR=127.0.0.1:8127
Environment=PUBLIC_URL=http://cd.libeasy.cn:8027
Environment=STATIC_DIR=/data/RevenueStatisticsSystem/current/web
Environment=DM_DSN_FILE=/data/RevenueStatisticsSystem/config/dm-dsn
Environment=OIDC_CLIENT_ID_FILE=/data/RevenueStatisticsSystem/config/oidc-client-id
Environment=OIDC_CLIENT_SECRET_FILE=/data/RevenueStatisticsSystem/config/oidc-client-secret
Environment=OIDC_ISSUER=http://cd.libeasy.cn:8012
Environment=CASDOOR_INTERNAL=http://127.0.0.1:8012
Environment=OIDC_ORGANIZATION=sx
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
