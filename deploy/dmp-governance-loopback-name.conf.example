# Compatibility for the running Quartz client without restarting incumbent jobs.
server {
    listen 80;
    server_name srt-cloud-data-governance;
    allow 127.0.0.1;
    deny all;
    location ~ ^/api/data/governance/(data-push-task/|data-push-config/|add-data-push-task-log$|update-data-push-task-log$) {
        proxy_pass http://127.0.0.1:8087;
        proxy_set_header Host $http_host;
        proxy_read_timeout 60s;
    }
    location / { return 404; }
}

